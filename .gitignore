backend/experiments/results/resolution/*.log
backend/experiments/results/resolution/run_studies.sh
# Post-Active-Inference benchmark: per-cell raw jobs (~550 MB, re-creatable with run_benchmark.py; summaries,
# tables, pre-registration and frozen source archives are kept), and local ZIP exports
research/post_active_inference/results/*/jobs/
artifacts/zips/
.cache/
